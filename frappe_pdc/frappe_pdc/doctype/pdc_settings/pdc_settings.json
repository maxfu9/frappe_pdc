{
  "doctype": "DocType",
  "name": "PDC Settings",
  "module": "Frappe PDC",
  "issingle": 1,
  "fields": [
    {
      "fieldname": "permissions_section",
      "fieldtype": "Section Break",
      "label": "Permissions"
    },
    {
      "fieldname": "manager_roles",
      "label": "PDC Manager Roles",
      "fieldtype": "Small Text",
      "default": "Accounts Manager\nSystem Manager",
      "description": "Users with any of these roles can register, clear, hand over, bounce, and approve PDCs."
    },
    {
      "fieldname": "workflow_section",
      "fieldtype": "Section Break",
      "label": "Workflow"
    },
    {
      "fieldname": "require_clearance_approval",
      "label": "Require Approval Before Clearance",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "allow_early_clearance",
      "label": "Allow Early Clearance",
      "fieldtype": "Check",
      "default": "0",
      "description": "Allow clearing a PDC before its cheque/reference date."
    },
    {
      "fieldname": "accounting_section",
      "fieldtype": "Section Break",
      "label": "Accounting"
    },
    {
      "fieldname": "pdc_receivable_account",
      "label": "Default PDC Receivable Account",
      "fieldtype": "Link",
      "options": "Account",
      "description": "Optional holding account copied to new PDC records for audit and future GL transfer controls."
    },
    {
      "fieldname": "bounce_charges_account",
      "label": "Bounce Charges Account",
      "fieldtype": "Link",
      "options": "Account",
      "description": "Optional income/charges account reserved for bounce-fee posting."
    },
    {
      "fieldname": "bounce_charges_item",
      "label": "Bounce Charges Item",
      "fieldtype": "Link",
      "options": "Item",
      "description": "Service item used when creating draft Sales Invoices for bounced-cheque charges."
    },
    {
      "fieldname": "notifications_section",
      "fieldtype": "Section Break",
      "label": "Notifications"
    },
    {
      "fieldname": "notify_accounts_managers",
      "label": "Notify PDC Managers on Maturity",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "notify_customers",
      "label": "Notify Customer on Maturity",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "reminder_days_before_maturity",
      "label": "Reminder Days Before Maturity",
      "fieldtype": "Int",
      "default": "0",
      "description": "Send pre-maturity reminders this many days before cheque/reference date."
    },
    {
      "fieldname": "notify_overdue_pdcs",
      "label": "Notify PDC Managers on Overdue Clearance",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "overdue_grace_days",
      "label": "Overdue Grace Days",
      "fieldtype": "Int",
      "default": "1"
    },
    {
      "fieldname": "notify_bounced_pdcs",
      "label": "Notify PDC Managers on Bounce",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "notify_replacement_followup",
      "label": "Notify PDC Managers for Replacement Follow-up",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "replacement_followup_days",
      "label": "Replacement Follow-up Days",
      "fieldtype": "Int",
      "default": "3"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Accounts Manager",
      "read": 1
    }
  ]
}
